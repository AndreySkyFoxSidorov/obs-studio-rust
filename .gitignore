# Default deny: only project source and the resources needed to build it.
/*
!/.gitignore
!/Cargo.toml
!/Cargo.lock
!/rust-toolchain.toml
!/LICENSE
!/README.md
!/CONTRIBUTING.md
!/SECURITY.md
!/CODE_OF_CONDUCT.md
!/third-party/
!/.cargo/
!/.github/
!/apps/
!/assets/
!/crates/
!/examples/
!/localization/
!/tools/
!/vendor/
!/xtask/

# Local research, working material, and generated output never enter Git.
/doc/
/evidence/
/staging/
/target/
/localization/translation-provenance.json
/localization/catalog-report.json

# Build output, caches, local settings, and secrets, including in allowed folders.
**/target/
**/__pycache__/
*.py[cod]
*.skylive.json
*.skylive.json.recovery
*.log
*.tmp
*.bak
*.swp
*.swo
*.exe
*.dll
*.pdb
*.obj
*.o
*.a
*.lib
*.so
*.dylib
*.zip
*.7z
*.tar
*.gz
.env
.env.*
*.pem
*.key
*.p12
*.pfx
.DS_Store
Thumbs.db
